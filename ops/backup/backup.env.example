# /etc/oraliq/backup.env — settings for oraliq_db_backup.py (systemd EnvironmentFile).
#   sudo install -m 600 -o root -g root backup.env.example /etc/oraliq/backup.env
# This file holds the database password: root-only, never in the repository, never in a log.

# ── Source database ───────────────────────────────────────────────────────────
# Use a DIRECT / session connection: pg_dump does not work through a transaction pooler
# (Supabase port 6543). A read-only role with SELECT on the app's tables is enough for backups.
BACKUP_DATABASE_URL=postgresql://BACKUP_USER:PASSWORD@HOST:5432/DBNAME?sslmode=require

# Schemas to dump. OralIQ keeps everything in "public"; managed providers add their own schemas
# (Supabase: auth, storage, ...) that can't be restored onto a plain PostgreSQL.
BACKUP_SCHEMAS=public

# Client tools of the server's major version or newer (e.g. /usr/lib/postgresql/16/bin).
# PG_BINDIR=/usr/lib/postgresql/16/bin

# ── Where backups go ──────────────────────────────────────────────────────────
# Outside the application folder, not in /tmp, mode 700, owned by the backup user.
BACKUP_DIR=/var/backups/oraliq
BACKUP_RETENTION_DAYS=30
# Never prune below this many verified backups, however old they are.
BACKUP_MIN_KEEP=7
# Reject an archive with fewer tables than this (catches dumping the wrong database).
BACKUP_MIN_TABLES=5
BACKUP_LOG_FILE=/var/backups/oraliq/backup.log

# ── Encryption at rest (gpg, public key only on this server) ──────────────────
# Import the PUBLIC key of an offline key pair for the backup user; keep the private key off the
# server (needed only to restore). Leave empty to store gzip without encryption.
# BACKUP_GPG_RECIPIENT=backups@your-domain
BACKUP_REQUIRE_ENCRYPTION=1

# ── Off-site copy (needs a decision: provider + account) ──────────────────────
# A command that receives three paths: <backup> <backup>.sha256 <backup>.json. No shell; e.g.
#   BACKUP_UPLOAD_COMMAND=/opt/oraliq/ops/backup/upload.sh
# where upload.sh copies them with rclone / aws s3 cp / scp to storage on another provider.
# Exit status 3 means: verified locally, NOT copied off-site (alerted).
# BACKUP_UPLOAD_COMMAND=
BACKUP_REQUIRE_OFFSITE=1

# ── Alert on failure ──────────────────────────────────────────────────────────
# A command that receives: FAILED "<message>" (already redacted). For example a script that
# posts to a Telegram/Slack webhook, sends mail, or pings a healthchecks.io "/fail" URL.
# BACKUP_ALERT_COMMAND=/opt/oraliq/ops/backup/notify.sh
