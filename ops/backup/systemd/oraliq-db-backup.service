# OralIQ nightly PostgreSQL backup — one run of oraliq_db_backup.py.
# Install: see ops/backup/README.md. Triggered by oraliq-db-backup.timer; on failure systemd starts
# oraliq-db-backup-alert@oraliq-db-backup.service.
[Unit]
Description=OralIQ PostgreSQL backup (pg_dump, verify, keep 30 days)
Wants=network-online.target
After=network-online.target
OnFailure=oraliq-db-backup-alert@%n.service

[Service]
Type=oneshot
User=oraliq-backup
Group=oraliq-backup
# Holds DATABASE_URL / BACKUP_* settings. chmod 600, owned by root (systemd reads it before
# dropping privileges), so the password never sits in this unit or in a command line.
EnvironmentFile=/etc/oraliq/backup.env
ExecStart=/usr/bin/python3 /opt/oraliq/ops/backup/oraliq_db_backup.py backup
# Any non-zero exit fails the unit and fires the alert, including 3 = backup verified locally but
# the off-site copy failed.
TimeoutStartSec=3h
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
UMask=0077

# Hardening: the job can write only to the backup folder.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/backups/oraliq
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
