# انسخ إلى local.env وعدّل القيم (لا ترفع local.env على Git)

# ── Run mode (required, no default) ───────────────────────────────────────────
#   dev         a developer machine: /docs, /debug, CORS "*", local SQLite, a key generated once
#   test        the test suite (set by app/tests/conftest.py)
#   production  every deployed server — refuses to start unless everything below marked
#               "production" is set and valid; /docs, /redoc, /openapi.json and /debug are off
# Missing or any other value: the API and the grading worker refuse to start.
ENV=dev

# Simulated payments: checkout activates the plan at once, no gateway, no money. Off unless set.
# dev/test only — with ENV=production the server refuses to start while this (or
# KASHIER_MODE=test) is on, and every activation path ignores it.
BILLING_SANDBOX=1

# Kashier (EGP payments). Test keys go with KASHIER_MODE=test (test-*.kashier.io hosts); live keys
# with KASHIER_MODE=live. Production always uses live and refuses to start with KASHIER_MODE=test.
# KASHIER_MERCHANT_ID=
# KASHIER_API_KEY=          # Payment API Key (api-key header + webhook signature)
# KASHIER_SECRET_KEY=       # Secret Key (Authorization header)
# KASHIER_MODE=test
# KASHIER_WEBHOOK_URL=      # optional: https://<backend>/api/v1/billing/webhook/kashier

# ── Required in production ────────────────────────────────────────────────────
# With ENV=production the server lists every missing/invalid one of these and exits.

# Signs every access token. At least 32 random characters (no placeholder or repeated pattern).
# Generate once and keep the same value for the life of the deployment and on every instance:
# change it and every signed-in user is logged out, mid-exam included. It is never generated
# or stored by the app in production.
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# SECRET_KEY=

# The sites allowed to call this API, comma separated, matched exactly: https://host[:port],
# no path, no "*". Nothing (not even localhost) is added for you.
# ALLOWED_ORIGINS=https://oraliq.com,https://www.oraliq.com

# PostgreSQL only; the server checks it can connect before it starts. There is no SQLite
# fallback in production.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres

# ── Database ──────────────────────────────────────────────────────────────────
# Development without DATABASE_URL uses a SQLite file in backend/data (a sqlite:/// URL may
# also be given explicitly). Tests use an in-memory database.
# For migrations (ALTER TABLE) on Supabase — use direct connection port 5432:
# DATABASE_URL_DIRECT=postgresql://USER:PASSWORD@HOST:5432/postgres

# ── Grading throughput ────────────────────────────────────────────────────────
# Answers are graded by a separate worker process (python -m app.worker), fed by a queue
# kept in the database. Submitting only stores the answer; the exam room polls for the grade.
#   embedded (default) — the API starts the worker as a child process and restarts it
#   external           — the API starts nothing; run `python -m app.worker` yourself
#                        (another container / machine on the same DATABASE_URL, any number)
#   off                — nothing grades (tests, or an API-only replica)
# GRADING_WORKER_MODE=embedded

# How many answers one worker process grades at the same time. Each job wants a few
# cores and roughly 2GB, so this decides how many answers an instance grades at once;
# answers past it wait in the queue. Default: cores / 4. On an 8-core box, 2 is a sensible start.
# MAX_CONCURRENT_GRADING=2
# (GRADING_WORKER_CONCURRENCY overrides it for the worker only.)

# Cores per transcription. Default: cores / MAX_CONCURRENT_GRADING.
# WHISPER_CPU_THREADS=4

# Parallel transcriptions inside one Whisper model. With 1, grading jobs take turns on Whisper
# even when MAX_CONCURRENT_GRADING is higher; each extra worker costs memory. Measure first.
# WHISPER_NUM_WORKERS=1

# Retries and recovery. A failed attempt is retried after 30s, 60s, ...; after
# GRADING_MAX_ATTEMPTS the answer is marked failed and a lecturer can re-run it. A job whose
# worker stopped heart-beating for GRADING_STALE_SECONDS is put back in the queue.
# GRADING_MAX_ATTEMPTS=3
# GRADING_RETRY_BASE_SECONDS=30
# GRADING_HEARTBEAT_SECONDS=15
# GRADING_STALE_SECONDS=120
# Recordings are deleted as soon as the grade is saved; for failed answers they are kept this
# many hours so the lecturer can re-run grading.
# GRADING_FAILED_AUDIO_RETENTION_HOURS=72

# "medium" is the default and is what the accuracy was tuned on. "small" roughly halves
# both the memory and the time, at a real cost in Arabic accuracy.
# WHISPER_MODEL=medium

# ── Behind a reverse proxy ────────────────────────────────────────────────────
# Set this only when nginx (or another proxy you control) sits in front and sets
# X-Forwarded-For. Switched on without such a proxy, any caller can claim any IP.
# TRUST_PROXY=true

# Requests per minute per signed-in session, or per IP for anonymous callers.
# RATE_LIMIT_PER_MIN=240

GEMINI_API_KEY=your-gemini-api-key


# ── E-mail verification (password sign-up) ───────────────────────────────────
# A password sign-up gets no session until its e-mailed link is opened with the same password.
# Development prints the message to the console; tests keep it in memory. Production needs SMTP
# (any provider) and FRONTEND_URL on https — without them password sign-up answers "unavailable"
# and Google sign-in keeps working.
# EMAIL_BACKEND=smtp
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURITY=starttls        # starttls | ssl | none
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=OralIQ <no-reply@your-domain>
# FRONTEND_URL=https://your-domain
# EMAIL_VERIFICATION_TTL_HOURS=24
# EMAIL_VERIFICATION_RESEND_SECONDS=60
# EMAIL_VERIFICATION_MAX_PER_HOUR=5
# Accounts created before verification existed keep signing in with their password (allow);
# set to block once their owners have had time to verify.
# LEGACY_UNVERIFIED_PASSWORD_LOGIN=allow

# ── Sign in with Google ─────────────────────────────────────────────────────
# OAuth 2.0 Client ID (type: Web application) from Google Cloud Console → APIs & Services →
# Credentials. Setting it is all it takes to show the Google button on Login/Register.
# Several clients? Separate with commas. Leave unset to disable Google sign-in.
# GOOGLE_CLIENT_ID=1234567890-abc123.apps.googleusercontent.com
